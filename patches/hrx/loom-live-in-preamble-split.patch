diff --git a/loom/src/loom/codegen/low/allocation_live_range_splitting.c b/loom/src/loom/codegen/low/allocation_live_range_splitting.c
index 322f29f..7a35615 100644
--- a/loom/src/loom/codegen/low/allocation_live_range_splitting.c
+++ b/loom/src/loom/codegen/low/allocation_live_range_splitting.c
@@ -103,8 +103,22 @@ static bool loom_low_allocation_value_can_split_after_definition(
       defining_op->parent_block == NULL) {
     return false;
   }
+  // Live-in and resource values are defined by the entry preamble, which must
+  // stay contiguous at the top of the entry block. Each preamble value occupies
+  // its ABI location from function entry, but allocation only sees it live
+  // from its own definition, so a packet placed between two preamble ops could
+  // be assigned a later preamble value's location and overwrite it. Split
+  // after the whole preamble.
+  loom_op_t* insertion_anchor = defining_op;
+  if (loom_low_live_in_isa(defining_op) || loom_low_resource_isa(defining_op)) {
+    while (insertion_anchor->next_op != NULL &&
+           (loom_low_live_in_isa(insertion_anchor->next_op) ||
+            loom_low_resource_isa(insertion_anchor->next_op))) {
+      insertion_anchor = insertion_anchor->next_op;
+    }
+  }
   *out_insertion_block = defining_op->parent_block;
-  *out_insertion_anchor = defining_op;
+  *out_insertion_anchor = insertion_anchor;
   return true;
 }
 
