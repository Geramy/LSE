 .../target/arch/amdgpu/planning/wait_plan.c   |   4 +
 .../target/arch/amdgpu/planning/wait_plan.h   |   4 +-
 .../test/source_low/low_allocation.loom-test  |   8 +-
 .../source_low/low_edge_copy_wait.loom-test   |   1 +
 .../low_memory_scalar_capture.loom-test       | 161 ----------------
 .../low_vmem_latency_schedule.loom-test       |   8 +-
 .../test/source_low/low_wait_plan.loom-test   |   4 +-
 .../amdgpu/test/spill_lowering.loom-test      |  12 +-
 9 files changed, 202 insertions(+), 180 deletions(-)

diff --git a/loom/py/loom/target/arch/amdgpu/descriptors/api.py b/loom/py/loom/target/arch/amdgpu/descriptors/api.py
index 1045866d1..5121072fb 100644
--- a/loom/py/loom/target/arch/amdgpu/descriptors/api.py
+++ b/loom/py/loom/target/arch/amdgpu/descriptors/api.py
@@ -889,6 +889,14 @@ _AMDGPU_READ_COUNTER_MASK = (
     | _AMDGPU_WAIT_COUNTER_MASKS[_COUNTER_ASYNC]
 )
 
+_AMDGPU_WRITE_COUNTER_MASK = (
+    _AMDGPU_WAIT_COUNTER_MASKS[_COUNTER_VMEM_STORE]
+    | _AMDGPU_WAIT_COUNTER_MASKS[_COUNTER_LDS]
+    | _AMDGPU_WAIT_COUNTER_MASKS[_COUNTER_SMEM]
+    | _AMDGPU_WAIT_COUNTER_MASKS[_COUNTER_TENSOR]
+    | _AMDGPU_WAIT_COUNTER_MASKS[_COUNTER_ASYNC]
+)
+
 _AMDGPU_STORAGE_LEASE_MEMORY_SPACES = frozenset(
     (
         MemorySpace.GENERIC,
@@ -924,6 +932,8 @@ _GFX125X_XCNT_SCHEDULE_CLASSES = frozenset(
 
 _AMDGPU_WAIT_PLAN_RESIDUAL_ACTION_WAIT_PACKET = 1
 _AMDGPU_WAIT_PLAN_RESIDUAL_ACTION_WAIT_PACKET_NAME = "amdgpu.wait_packet"
+_AMDGPU_WAIT_PLAN_REASON_STORE_SOURCE_REUSE = 4
+_AMDGPU_WAIT_PLAN_REASON_STORE_SOURCE_REUSE_NAME = "amdgpu.store_source_reuse"
 _AMDGPU_WAIT_PLAN_REASON_READ_RESULT_REUSE = 5
 _AMDGPU_WAIT_PLAN_REASON_READ_RESULT_REUSE_NAME = "amdgpu.read_result_reuse"
 _AMDGPU_WAIT_PLAN_REASON_MEMORY_SOURCE_REUSE = 10
@@ -1010,6 +1020,27 @@ def _amdgpu_storage_lease_result_counter_mask(
     return read_counter_mask
 
 
+def _amdgpu_storage_lease_write_counter_mask(
+    schedule_classes: dict[str, ScheduleClass],
+    descriptor: Descriptor,
+) -> int:
+    hazard_counter_mask = _amdgpu_descriptor_hazard_counter_mask(
+        schedule_classes, descriptor
+    )
+    write_counter_mask = 0
+    for effect in descriptor.effects:
+        if not _amdgpu_storage_lease_effect_is_dependency_memory(effect):
+            continue
+        if effect.kind is EffectKind.WRITE:
+            write_counter_mask |= _amdgpu_effect_counter_mask(
+                descriptor,
+                effect,
+                hazard_counter_mask,
+                _AMDGPU_WRITE_COUNTER_MASK,
+            )
+    return write_counter_mask
+
+
 def _amdgpu_storage_lease(
     *,
     kind: StorageLeaseKind,
@@ -1046,11 +1077,128 @@ def _amdgpu_operand_is_packet_input(operand: Operand) -> bool:
     )
 
 
+def _amdgpu_operand_accepts_vgpr(operand: Operand) -> bool:
+    return any(
+        reg_alt.reg_class == _REG_VGPR
+        and RegClassAltFlag.IMMEDIATE not in reg_alt.flags
+        for reg_alt in operand.reg_alts
+    )
+
+
+def _amdgpu_operand_accepts_sgpr(operand: Operand) -> bool:
+    return any(
+        reg_alt.reg_class == _REG_SGPR
+        and RegClassAltFlag.IMMEDIATE not in reg_alt.flags
+        for reg_alt in operand.reg_alts
+    )
+
+
+def _amdgpu_append_memory_source_leases(
+    storage_leases: list[StorageLease],
+    operand: Operand,
+    packet_operand_index: int,
+    counter_mask: int,
+) -> None:
+    for counter_id, counter_bit in _AMDGPU_WAIT_COUNTER_MASKS.items():
+        if (counter_mask & counter_bit) == 0:
+            continue
+        storage_leases.append(
+            _amdgpu_storage_lease(
+                kind=StorageLeaseKind.SOURCE_READ,
+                attachment=StorageLeaseAttachment.OPERAND,
+                attachment_index=packet_operand_index,
+                unit_count=operand.unit_count,
+                release_class_id=counter_id,
+                release_reason_id=_AMDGPU_WAIT_PLAN_REASON_MEMORY_SOURCE_REUSE,
+                release_reason_name=_AMDGPU_WAIT_PLAN_REASON_MEMORY_SOURCE_REUSE_NAME,
+                flags=_AMDGPU_STORAGE_LEASE_FLAGS,
+            )
+        )
+
+
+def _amdgpu_completion_source_leases(
+    schedule_classes: dict[str, ScheduleClass],
+    descriptor: Descriptor,
+    read_counter_mask: int,
+    *,
+    enable_gfx125x_xcnt: bool,
+) -> list[StorageLease]:
+    # Descriptor sets without issue-captured sources keep every memory source
+    # leased until the access completes: scalar address inputs until VMEM load,
+    # VMEM store or tensor completion, and VMEM store VGPR sources until store
+    # completion.
+    write_counter_mask = _amdgpu_storage_lease_write_counter_mask(
+        schedule_classes, descriptor
+    )
+    storage_leases: list[StorageLease] = []
+    memory_source_read_counter_mask = read_counter_mask & (
+        _AMDGPU_WAIT_COUNTER_MASKS[_COUNTER_VMEM_LOAD]
+        | _AMDGPU_WAIT_COUNTER_MASKS[_COUNTER_TENSOR]
+    )
+    memory_source_write_counter_mask = write_counter_mask & (
+        _AMDGPU_WAIT_COUNTER_MASKS[_COUNTER_VMEM_STORE]
+        | _AMDGPU_WAIT_COUNTER_MASKS[_COUNTER_TENSOR]
+    )
+    vmem_write_counter_mask = (
+        write_counter_mask & _AMDGPU_WAIT_COUNTER_MASKS[_COUNTER_VMEM_STORE]
+    )
+    xcnt_source_counter_mask = (
+        _AMDGPU_WAIT_COUNTER_MASKS[_COUNTER_X]
+        if enable_gfx125x_xcnt
+        and descriptor.schedule_class in _GFX125X_XCNT_SCHEDULE_CLASSES
+        else 0
+    )
+    if (
+        memory_source_read_counter_mask != 0
+        or memory_source_write_counter_mask != 0
+        or xcnt_source_counter_mask != 0
+    ):
+        packet_operand_index = 0
+        for operand in descriptor.operands[_descriptor_result_count(descriptor) :]:
+            if not _amdgpu_operand_is_packet_input(operand):
+                continue
+            current_packet_operand_index = packet_operand_index
+            packet_operand_index += 1
+            if operand.unit_count == 0:
+                continue
+            if xcnt_source_counter_mask != 0:
+                _amdgpu_append_memory_source_leases(
+                    storage_leases,
+                    operand,
+                    current_packet_operand_index,
+                    xcnt_source_counter_mask,
+                )
+            if _amdgpu_operand_accepts_vgpr(operand) and vmem_write_counter_mask != 0:
+                storage_leases.append(
+                    _amdgpu_storage_lease(
+                        kind=StorageLeaseKind.SOURCE_READ,
+                        attachment=StorageLeaseAttachment.OPERAND,
+                        attachment_index=current_packet_operand_index,
+                        unit_count=operand.unit_count,
+                        release_class_id=_COUNTER_VMEM_STORE,
+                        release_reason_id=_AMDGPU_WAIT_PLAN_REASON_STORE_SOURCE_REUSE,
+                        release_reason_name=(
+                            _AMDGPU_WAIT_PLAN_REASON_STORE_SOURCE_REUSE_NAME
+                        ),
+                        flags=_AMDGPU_STORAGE_LEASE_FLAGS,
+                    )
+                )
+            if _amdgpu_operand_accepts_sgpr(operand):
+                _amdgpu_append_memory_source_leases(
+                    storage_leases,
+                    operand,
+                    current_packet_operand_index,
+                    memory_source_read_counter_mask | memory_source_write_counter_mask,
+                )
+    return storage_leases
+
+
 def _amdgpu_descriptor_storage_leases(
     schedule_classes: dict[str, ScheduleClass],
     descriptor: Descriptor,
     *,
     enable_gfx125x_xcnt: bool,
+    issue_captured_sources: bool,
 ) -> tuple[StorageLease, ...]:
     if descriptor.storage_leases:
         raise ValueError(
@@ -1082,6 +1230,16 @@ def _amdgpu_descriptor_storage_leases(
                     flags=_AMDGPU_PRESSURE_STORAGE_LEASE_FLAGS,
                 )
             )
+    if not issue_captured_sources:
+        storage_leases.extend(
+            _amdgpu_completion_source_leases(
+                schedule_classes,
+                descriptor,
+                read_counter_mask,
+                enable_gfx125x_xcnt=enable_gfx125x_xcnt,
+            )
+        )
+        return tuple(storage_leases)
     # Memory completion owns result storage, not address inputs. Supported native
     # families capture scalar inputs independently of completion. Gfx125x
     # SMEM/VMEM packets retain their inputs until the separate X event; tensor
@@ -1124,7 +1282,10 @@ def _descriptor_result_count(descriptor: Descriptor) -> int:
 
 
 def _with_storage_lease_rows(
-    descriptor_set: DescriptorSet, *, enable_gfx125x_xcnt: bool = False
+    descriptor_set: DescriptorSet,
+    *,
+    enable_gfx125x_xcnt: bool = False,
+    issue_captured_sources: bool = True,
 ) -> DescriptorSet:
     schedule_classes = {
         schedule_class.name: schedule_class
@@ -1139,6 +1300,7 @@ def _with_storage_lease_rows(
                     schedule_classes,
                     descriptor,
                     enable_gfx125x_xcnt=enable_gfx125x_xcnt,
+                    issue_captured_sources=issue_captured_sources,
                 ),
             )
             for descriptor in descriptor_set.descriptors
@@ -1225,6 +1387,12 @@ def _with_instruction_classes(descriptor_set: DescriptorSet) -> DescriptorSet:
 
 
 _AMDGPU_CORE_DESCRIPTOR_SET_BUILDER_FLAG_GFX125X = 1 << 0
+# VMEM store VGPR sources and scalar memory sources are released when the
+# packet issues instead of when the access completes. Set for the gfx11
+# (RDNA3/3.5) sets only: on LSE's qwen38-27b-q4 kernels this measured faster
+# decode on gfx1151 (plain +2%, DFlash2 +6-22%) but 1-9% slower MTP and DFlash2
+# decode on gfx1201, so the other sets keep completion-released leases.
+_AMDGPU_CORE_DESCRIPTOR_SET_BUILDER_FLAG_ISSUE_CAPTURED_SOURCES = 1 << 1
 
 
 @dataclass(frozen=True, slots=True)
@@ -1265,12 +1433,14 @@ _AMDGPU_CORE_DESCRIPTOR_SET_BUILDERS = {
         overlay_rows=_gfx11_core_overlays,
         overlay_descriptors=_gfx11_core_overlay_descriptors,
         extra_descriptors=(_s_delay_alu_descriptor(),),
+        flags=_AMDGPU_CORE_DESCRIPTOR_SET_BUILDER_FLAG_ISSUE_CAPTURED_SOURCES,
     ),
     "gfx11_generic": _AmdgpuCoreDescriptorSetBuilder(
         base=_AMDGPU_GFX11_GENERIC_CORE_DESCRIPTOR_SET_BASE,
         overlay_rows=_gfx11_generic_core_overlays,
         overlay_descriptors=_gfx11_generic_core_overlay_descriptors,
         extra_descriptors=(_s_delay_alu_descriptor(),),
+        flags=_AMDGPU_CORE_DESCRIPTOR_SET_BUILDER_FLAG_ISSUE_CAPTURED_SOURCES,
     ),
     "gfx12_generic": _AmdgpuCoreDescriptorSetBuilder(
         base=_AMDGPU_GFX12_GENERIC_CORE_DESCRIPTOR_SET_BASE,
@@ -1290,6 +1460,7 @@ _AMDGPU_CORE_DESCRIPTOR_SET_BUILDERS = {
         overlay_rows=_gfx117x_core_overlays,
         overlay_descriptors=_gfx117x_core_overlay_descriptors,
         extra_descriptors=(_s_delay_alu_descriptor(),),
+        flags=_AMDGPU_CORE_DESCRIPTOR_SET_BUILDER_FLAG_ISSUE_CAPTURED_SOURCES,
     ),
     "rdna4": _AmdgpuCoreDescriptorSetBuilder(
         base=_AMDGPU_RDNA4_CORE_DESCRIPTOR_SET_BASE,
@@ -1340,7 +1511,12 @@ def _build_amdgpu_core_descriptor_set_from_spec(
     if is_gfx125x:
         descriptor_set = _with_gfx125x_vgpr_msb_address_states(descriptor_set)
     descriptor_set = _with_storage_lease_rows(
-        descriptor_set, enable_gfx125x_xcnt=is_gfx125x
+        descriptor_set,
+        enable_gfx125x_xcnt=is_gfx125x,
+        issue_captured_sources=bool(
+            builder.flags
+            & _AMDGPU_CORE_DESCRIPTOR_SET_BUILDER_FLAG_ISSUE_CAPTURED_SOURCES
+        ),
     )
     descriptor_set = _with_instruction_classes(descriptor_set)
     _validate_descriptor_encoding_formats(target, spec, descriptor_set)
diff --git a/loom/src/loom/target/arch/amdgpu/planning/wait_plan.c b/loom/src/loom/target/arch/amdgpu/planning/wait_plan.c
