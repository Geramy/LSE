diff --git a/libhrx/src/libhrx/device.c b/libhrx/src/libhrx/device.c
index c269786aa..565f2212e 100644
--- a/libhrx/src/libhrx/device.c
+++ b/libhrx/src/libhrx/device.c
@@ -200,6 +200,9 @@ void hrx_device_release(hrx_device_t device) {
   iree_hal_device_t* hal_device = device->hal_device;
   iree_hal_device_group_t* hal_device_group = device->hal_device_group;
   if (iree_atomic_ref_count_dec(&device->ref_count) == 1) {
+    iree_hal_pool_release(device->stream_pools.pool);
+    device->stream_pools.pool = NULL;
+    iree_slim_mutex_deinitialize(&device->stream_pools.mutex);
     hrx_mem_pool_backing_deinitialize(&device->mem_pool_backing);
     iree_hal_allocator_release(device->allocator.hal_allocator);
     device->allocator.hal_allocator = NULL;
diff --git a/libhrx/src/libhrx/hrx_internal.h b/libhrx/src/libhrx/hrx_internal.h
index 279a104b6..adf0b4a7a 100644
--- a/libhrx/src/libhrx/hrx_internal.h
+++ b/libhrx/src/libhrx/hrx_internal.h
@@ -256,6 +256,13 @@ typedef struct hrx_device_s {
   hrx_allocator_s allocator;           // Inline, owned by device.
   hrx_buffer_table_t buffer_table;     // Device-pointer-to-buffer lookup.
   iree_arena_block_pool_t block_pool;  // Shared arena pool for graphs.
+  // The pool that backs hrx_buffer_allocate on the macOS adapter: one TLSF
+  // policy over the device's shared memory-pool backing, created on first use.
+  // Buffers retain the pool; the device drops its reference on final release.
+  struct {
+    iree_slim_mutex_t mutex;
+    iree_hal_pool_t* pool;
+  } stream_pools;
   char name[128];
   char architecture[64];
 } hrx_device_s;
@@ -642,6 +649,11 @@ iree_status_t hrx_hal_device_select_queue(
 hrx_status_t hrx_device_query_queue_count(hrx_device_t device,
                                           uint32_t* out_count);
 
+// Returns, retained, the stream-ordered allocation pool of |device|, creating
+// it over the device's shared memory-pool backing on first use.
+iree_status_t hrx_device_select_stream_pool(hrx_device_t device,
+                                            iree_hal_pool_t** out_pool);
+
 // Convert iree_status_t to hrx_status_t.
 hrx_status_t hrx_status_from_iree(iree_status_t iree_status);
 
diff --git a/libhrx/src/libhrx/mem_pool_backing.c b/libhrx/src/libhrx/mem_pool_backing.c
index 5d2a53989..3116d32ee 100644
--- a/libhrx/src/libhrx/mem_pool_backing.c
+++ b/libhrx/src/libhrx/mem_pool_backing.c
@@ -282,3 +282,20 @@ void hrx_mem_pool_backing_trim(hrx_mem_pool_backing_t* backing,
   }
   iree_slim_mutex_unlock(&backing->mutex);
 }
+
+iree_status_t hrx_device_select_stream_pool(hrx_device_t device,
+                                            iree_hal_pool_t** out_pool) {
+  *out_pool = NULL;
+  iree_status_t status = iree_ok_status();
+  iree_slim_mutex_lock(&device->stream_pools.mutex);
+  if (!device->stream_pools.pool) {
+    status = hrx_mem_pool_backing_create_pool(device,
+                                              &device->stream_pools.pool);
+  }
+  if (iree_status_is_ok(status)) {
+    iree_hal_pool_retain(device->stream_pools.pool);
+    *out_pool = device->stream_pools.pool;
+  }
+  iree_slim_mutex_unlock(&device->stream_pools.mutex);
+  return status;
+}
