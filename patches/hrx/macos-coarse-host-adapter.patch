diff --git a/libhrx/src/libhrx/stream.c b/libhrx/src/libhrx/stream.c
index 7cbbb6b39..4e71e2bec 100644
--- a/libhrx/src/libhrx/stream.c
+++ b/libhrx/src/libhrx/stream.c
@@ -6,6 +6,10 @@
 // Adapted from iree-hal-streaming's stream.c timeline semaphore pattern.
 
 #include <stdlib.h>
+#if defined(IREE_HAL_AMDGPU_MACOS_COARSE_HOST_ADAPTER)
+#include <pthread.h>
+static pthread_mutex_t hrx_profile_flush_mutex = PTHREAD_MUTEX_INITIALIZER;
+#endif
 
 #include "hrx_internal.h"
 
@@ -211,7 +215,20 @@ hrx_status_t hrx_stream_synchronize(hrx_stream_t stream) {
     HRX_RETURN_AND_END_ZONE(z0, status);
   }
 
-  HRX_RETURN_AND_END_ZONE(z0, hrx_stream_wait(stream));
+  status = hrx_stream_wait(stream);
+#if defined(IREE_HAL_AMDGPU_MACOS_COARSE_HOST_ADAPTER)
+  if (hrx_status_is_ok(status) && stream->device->profiling_active) {
+    // Retire ready events at the application's existing synchronization point.
+    // No extra device wait and no per-dispatch flush: this bounds the 64K event
+    // ring across long model runs while preserving normal batching.
+    pthread_mutex_lock(&hrx_profile_flush_mutex);
+    iree_status_t flushed =
+        iree_hal_device_profiling_flush(stream->device->hal_device);
+    pthread_mutex_unlock(&hrx_profile_flush_mutex);
+    status = hrx_status_from_iree(flushed);
+  }
+#endif
+  HRX_RETURN_AND_END_ZONE(z0, status);
 }
 
 hrx_status_t hrx_stream_wait(hrx_stream_t stream) {
