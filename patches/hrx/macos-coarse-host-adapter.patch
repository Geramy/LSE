@@ -0,0 +1,24 @@
+// Copyright 2026 The IREE Authors
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef IREE_HAL_DRIVERS_AMDGPU_SAME_QUEUE_PREFIX_H_
+#define IREE_HAL_DRIVERS_AMDGPU_SAME_QUEUE_PREFIX_H_
+#include <stdbool.h>
+#include <stdint.h>
+
+// Eligibility for an actual BARRIER_AND packet, never wait elision.
+// Call only after checking semaphore health and submitted signal value, while
+// holding submission_mutex. The marker names only the latest submission whose
+// completion needs no host pre-signal action. Zero means unqualified. Every
+// earlier host action must also have drained: normal notification publication
+// waits for those actions even when this exact epoch itself is GPU-only.
+static inline bool iree_hal_amdgpu_same_queue_prefix_eligible(
+    uint64_t queue_axis, uint64_t producer_axis,
+    uint64_t target_epoch, uint64_t device_only_epoch,
+    uint64_t last_published_epoch, uint64_t last_host_action_epoch,
+    uint64_t last_drained_epoch) {
+  return queue_axis == producer_axis && target_epoch != 0 &&
+         target_epoch == device_only_epoch &&
+         target_epoch <= last_published_epoch &&
+         last_drained_epoch >= last_host_action_epoch;
+}
+#endif
