     } else {
+#if defined(IREE_HAL_AMDGPU_MACOS_COARSE_HOST_ADAPTER)
+      // Opt-in process capture must latch CP profiling before any setup
+      // dispatch. Starting a new collection on an already used queue is
+      // intentionally not supported by this adapter; it would require
+      // synchronized queue remapping.
+      const char* profile_file = getenv("HRX_PROFILE_FILE");
+      const char* profile_mode = getenv("HRX_PROFILE_MODE");
+      if (profile_file && profile_file[0] && profile_mode &&
+          strcmp(profile_mode, "dispatch") == 0) {
