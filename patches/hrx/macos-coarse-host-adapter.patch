+            IREE_LIBHSA(params->hardware.libhsa), hardware_queue, 1);
+        out_queue->profiling.macos_profile_latched = iree_status_is_ok(status);
+      }
+#endif
       iree_hal_amdgpu_aql_ring_initialize(
           params->hardware.libhsa, (iree_amd_queue_t*)hardware_queue,
           params->hardware.aql_execution_mode, &out_queue->aql_ring);
@@ -1314,6 +1331,13 @@ iree_status_t iree_hal_amdgpu_host_queue_set_hsa_profiling_enabled(
   IREE_TRACE_ZONE_BEGIN(z0);
   IREE_TRACE_ZONE_APPEND_VALUE_I64(z0, enabled ? 1 : 0);
 
+#if defined(IREE_HAL_AMDGPU_MACOS_COARSE_HOST_ADAPTER)
+  if (enabled && !queue->profiling.macos_profile_latched) {
+    return iree_make_status(IREE_STATUS_FAILED_PRECONDITION,
+        "macOS dispatch profiling requires HRX_PROFILE_FILE and "
+        "HRX_PROFILE_MODE=dispatch before device creation");
+  }
+#endif
   if (enabled) {
     IREE_RETURN_AND_END_ZONE_IF_ERROR(
         z0, iree_hal_amdgpu_host_queue_ensure_profile_event_storage(queue));
@@ -1323,8 +1347,14 @@ iree_status_t iree_hal_amdgpu_host_queue_set_hsa_profiling_enabled(
     iree_hal_amdgpu_host_queue_clear_profile_events(queue);
   }
 
+#if defined(IREE_HAL_AMDGPU_MACOS_COARSE_HOST_ADAPTER)
+  // Collection can end while the immutable CP property remains enabled. Its
+  // queue is retired normally; future unprofiled packets have no private slots.
+  iree_status_t status = iree_ok_status();
+#else
   iree_status_t status = iree_hsa_amd_profiling_set_profiler_enabled(
       IREE_LIBHSA(queue->libhsa), queue->hardware_queue, enabled ? 1 : 0);
+#endif
   if (iree_status_is_ok(status)) {
     queue->profiling.hsa_queue_timestamps_enabled = enabled ? 1 : 0;
   }
