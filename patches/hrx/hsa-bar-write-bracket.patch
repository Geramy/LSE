diff --git a/runtime/src/iree/hal/drivers/amdgpu/device/support/aligned_store.h b/runtime/src/iree/hal/drivers/amdgpu/device/support/aligned_store.h
new file mode 100644
index 000000000..8e1479d46
--- /dev/null
+++ b/runtime/src/iree/hal/drivers/amdgpu/device/support/aligned_store.h
@@ -0,0 +1,57 @@
+// Copyright 2026 The IREE Authors
+//
+// Licensed under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+// Host-side iree_amdgpu_memcpy/memset for the macOS adapter, where kernel
+// arguments may be written straight into CPU-visible VRAM. Apple silicon maps
+// a BAR as device memory, where every access must be aligned to its size;
+// libc's memcpy and memset use unaligned and overlapping wide accesses. These
+// store only naturally aligned bytes and 64-bit words (loads from |src|, host
+// memory, may be unaligned). Elsewhere they are memcpy and memset.
+
+#ifndef IREE_HAL_DRIVERS_AMDGPU_DEVICE_SUPPORT_ALIGNED_STORE_H_
+#define IREE_HAL_DRIVERS_AMDGPU_DEVICE_SUPPORT_ALIGNED_STORE_H_
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#if defined(IREE_HAL_AMDGPU_MACOS_COARSE_HOST_ADAPTER)
+
+static inline void iree_amdgpu_memcpy(void* dst, const void* src,
+                                      size_t length) {
+  volatile uint8_t* d = (volatile uint8_t*)dst;
+  const uint8_t* s = (const uint8_t*)src;
+  while (length && ((uintptr_t)d & 7)) {
+    *d++ = *s++;
+    --length;
+  }
+  for (; length >= 8; length -= 8, d += 8, s += 8) {
+    uint64_t word;
+    __builtin_memcpy(&word, s, sizeof(word));
+    *(volatile uint64_t*)d = word;
+  }
+  while (length--) *d++ = *s++;
+}
+
+static inline void iree_amdgpu_memset(void* dst, int value, size_t length) {
+  volatile uint8_t* d = (volatile uint8_t*)dst;
+  const uint64_t word = 0x0101010101010101ull * (uint8_t)value;
+  while (length && ((uintptr_t)d & 7)) {
+    *d++ = (uint8_t)value;
+    --length;
+  }
+  for (; length >= 8; length -= 8, d += 8) *(volatile uint64_t*)d = word;
+  while (length--) *d++ = (uint8_t)value;
+}
+
+#elif !defined(iree_amdgpu_memcpy)
+
+#define iree_amdgpu_memcpy memcpy
+#define iree_amdgpu_memset memset
+
+#endif  // IREE_HAL_AMDGPU_MACOS_COARSE_HOST_ADAPTER
+
+#endif  // IREE_HAL_DRIVERS_AMDGPU_DEVICE_SUPPORT_ALIGNED_STORE_H_
