+++ b/runtime/src/iree/hal/drivers/amdgpu/host_queue.h
@@ -309,6 +309,11 @@ typedef struct iree_hal_amdgpu_host_queue_t {
     // Serializes the post-drain continuation list.
     iree_slim_mutex_t post_drain_mutex;
   } locks;
+#if defined(IREE_HAL_AMDGPU_MACOS_COARSE_HOST_ADAPTER)
+  // Whether the holder of submission_mutex holds a BAR-write bracket
+  // (iree_hal_amdgpu_host_queue_lock_submission). Guarded by the mutex.
+  bool bar_write_bracket_held;
+#endif  // IREE_HAL_AMDGPU_MACOS_COARSE_HOST_ADAPTER
 
   // Post-drain continuation queue for work that cannot run while notification
   // drain is still publishing or reclaiming ring state.
@@ -699,6 +704,39 @@ iree_status_t iree_hal_amdgpu_host_queue_initialize(
     uint32_t upload_capacity, iree_allocator_t host_allocator,
     iree_hal_amdgpu_host_queue_t* out_queue);
 
+// Acquires the submission lock. With kernel arguments in CPU-visible VRAM
+// on the mac_linuxgpu runtime, every host store into the BARs a submission
+// makes (the kernarg memcpy, the HDP flush store and read back, the
+// doorbell) happens while this lock is held, so the lock also opens the
+// runtime's BAR-write bracket: one bracket per submission. The bracket
+// waits while the driver holds the device for a power transition or a
+// reset. Once the device is gone for this process it opens no bracket; the
+// runtime has replaced every BAR mapping with host memory first, so the
+// submission's stores land there and its doorbell fails.
+static inline void iree_hal_amdgpu_host_queue_lock_submission(
+    iree_hal_amdgpu_host_queue_t* queue) {
+  iree_slim_mutex_lock(&queue->locks.submission_mutex);
+#if defined(IREE_HAL_AMDGPU_MACOS_COARSE_HOST_ADAPTER)
+  void* writer = queue->kernarg_ring.publication.bar_writer;
+  queue->bar_write_bracket_held =
+      writer && queue->libhsa->mac_hsa_bar_write_begin(writer) ==
+                    HSA_STATUS_SUCCESS;
+#endif  // IREE_HAL_AMDGPU_MACOS_COARSE_HOST_ADAPTER
+}
+
+// Releases the submission lock and the bracket it opened.
+static inline void iree_hal_amdgpu_host_queue_unlock_submission(
+    iree_hal_amdgpu_host_queue_t* queue) {
+#if defined(IREE_HAL_AMDGPU_MACOS_COARSE_HOST_ADAPTER)
+  if (queue->bar_write_bracket_held) {
+    queue->bar_write_bracket_held = false;
+    queue->libhsa->mac_hsa_bar_write_end(
+        queue->kernarg_ring.publication.bar_writer);
+  }
+#endif  // IREE_HAL_AMDGPU_MACOS_COARSE_HOST_ADAPTER
+  iree_slim_mutex_unlock(&queue->locks.submission_mutex);
+}
+
