+  // process that stores into the GPU's BARs on its submission path (kernel
+  // arguments in CPU-visible VRAM, the HDP flush register, the doorbell)
+  // opts in once per GPU agent and brackets each submission's stores.
+  hsa_status_t (*mac_hsa_bar_writes_enable)(hsa_agent_t agent, void** writer);
+  hsa_status_t (*mac_hsa_bar_write_begin)(void* writer);
+  void (*mac_hsa_bar_write_end)(void* writer);
+#endif  // IREE_HAL_AMDGPU_MACOS_COARSE_HOST_ADAPTER
 } iree_hal_amdgpu_libhsa_t;
 
