+#if defined(__APPLE__)
+#include <TargetConditionals.h>
+#endif  // __APPLE__
+
+// An iOS app can only run code signed into its own bundle and the vendor
+// aqlprofile library is never part of it, so do not probe the filesystem with
+// dlopen there: counter and trace profiling report themselves unavailable.
+#if defined(TARGET_OS_IOS) && TARGET_OS_IOS
+#define IREE_HAL_AMDGPU_LIBAQLPROFILE_LOADABLE 0
+#else
+#define IREE_HAL_AMDGPU_LIBAQLPROFILE_LOADABLE 1
+#endif  // TARGET_OS_IOS
+
 // Keep vendor aqlprofile headers private to this translation unit. The public
 // wrapper mirrors only the narrow ABI surface used by the HAL so callers do not
 // inherit a large global vendor namespace.
@@ -108,6 +121,7 @@ enum {
 // Utilities
 //===----------------------------------------------------------------------===//
 
+#if IREE_HAL_AMDGPU_LIBAQLPROFILE_LOADABLE
