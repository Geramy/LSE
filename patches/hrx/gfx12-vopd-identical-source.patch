-static bool loom_amdgpu_vopd_bank_compatible(uint16_t x_register,
-                                             uint16_t y_register,
-                                             uint16_t bank_mask) {
-  return (x_register & bank_mask) != (y_register & bank_mask);
+static bool loom_amdgpu_vopd_bank_compatible(
+    uint16_t x_register, uint16_t y_register, uint16_t bank_mask,
+    bool allows_same_vgpr_sources) {
+  // Component readers admit one 32-bit physical VGPR per explicit source,
+  // including packed DOT2; wider allocations never reach this comparison.
+  return (x_register & bank_mask) != (y_register & bank_mask) ||
+         (allows_same_vgpr_sources && x_register == y_register);
 }
 
