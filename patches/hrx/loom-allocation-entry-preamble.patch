   // Number of user-facing errors emitted while constructing the model.
   uint32_t error_count;
 } loom_low_function_model_t;
diff --git a/loom/src/loom/target/arch/amdgpu/test/source_low/low_allocation.loom-test b/loom/src/loom/target/arch/amdgpu/test/source_low/low_allocation.loom-test
index f5b50065e..8b0e54b76 100644
--- a/loom/src/loom/target/arch/amdgpu/test/source_low/low_allocation.loom-test
+++ b/loom/src/loom/target/arch/amdgpu/test/source_low/low_allocation.loom-test
@@ -413,3 +413,172 @@ low.func.def target<amdgpu.rdna3.core>(@target) @loaded_chained_destructive_sgpr
   %active_block_count = low.op<amdgpu.s_lshr_b32.rhs_inline>(%padded_active_row_count) {imm32 = 6} : (reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr>
   low.return %active_block_count : reg<amdgpu.sgpr>
 }
+
+// ====
+
+// Fixed live-ins are live in their ABI registers from kernel entry. Splitting
+// %kernarg and %group under SGPR pressure must place the split copies, and the
+// spill traffic that follows them, after the whole live-in preamble: placed
+// before %lane, the spill traffic's temporary VGPR could take v0 and overwrite
+// the workitem id before it is read.
+// RUN: emit amdgpu-assembly @live_in_split_follows_entry_preamble strategy=source amdgpu.sgpr=7 fixed=%kernarg:physical_register:0:2 fixed=%group:physical_register:2:1 fixed=%lane:physical_register:0:1
+amdgpu.target<gfx1151> @target
+
+low.kernel.def target<amdgpu.rdna3_5.core>(@target) abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 1, resource_count = 1, resource_offsets = [0], resource_parameter_indices = [0], uses_kernarg_segment_ptr = true}) workgroup_size(64, 1, 1) @live_in_split_follows_entry_preamble() {
+  %kernarg = low.live_in<amdgpu.kernarg_segment_ptr> : reg<amdgpu.sgpr x2>
+  %group = low.live_in<amdgpu.workgroup_id.x> : reg<amdgpu.sgpr>
+  %lane = low.live_in<amdgpu.workitem_id.x> : reg<amdgpu.vgpr>
+  %x0 = low.op<amdgpu.s_load_dword_offset_only>(%kernarg) {offset = 8} : (reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr>
+  %y0 = low.op<amdgpu.s_mul_i32>(%x0, %x0) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr>
+  %x1 = low.op<amdgpu.s_load_dword_offset_only>(%kernarg) {offset = 12} : (reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr>
+  %y1 = low.op<amdgpu.s_mul_i32>(%x1, %x1) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr>
+  %x2 = low.op<amdgpu.s_load_dword_offset_only>(%kernarg) {offset = 16} : (reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr>
+  %y2 = low.op<amdgpu.s_mul_i32>(%x2, %x2) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr>
+  %x3 = low.op<amdgpu.s_load_dword_offset_only>(%kernarg) {offset = 20} : (reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr>
+  %y3 = low.op<amdgpu.s_mul_i32>(%x3, %x3) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr>
+  %x4 = low.op<amdgpu.s_load_dword_offset_only>(%kernarg) {offset = 24} : (reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr>
+  %y4 = low.op<amdgpu.s_mul_i32>(%x4, %x4) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr>
+  %s1 = low.op<amdgpu.s_add_u32>(%y0, %y1) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr>
+  %s2 = low.op<amdgpu.s_add_u32>(%s1, %y2) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr>
+  %s3 = low.op<amdgpu.s_add_u32>(%s2, %y3) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr>
+  %s4 = low.op<amdgpu.s_add_u32>(%s3, %y4) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr>
+  %sum = low.op<amdgpu.s_add_u32>(%s4, %group) : (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) -> reg<amdgpu.sgpr>
+  %output = low.op<amdgpu.s_load_dwordx2_offset_only>(%kernarg) {offset = 0} : (reg<amdgpu.sgpr x2>) -> reg<amdgpu.sgpr x2>
+  %value = low.op<amdgpu.v_mov_b32_copy>(%sum) : (reg<amdgpu.sgpr>) -> reg<amdgpu.vgpr>
+  %address = low.op<amdgpu.v_lshlrev_b32.src0_inline>(%lane) {imm32 = 2} : (reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr>
+  low.op<amdgpu.global_store_b32_saddr>(%address, %value, %output) {offset = 0} : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.sgpr x2>)
+  low.return
+}
+
+// ----
+s_mov_b32 s4, s0
+  s_mov_b32 s5, s1
+  s_mov_b64_exec_read s[0:1]
+  s_mov_b64 exec, -1
+  v_mov_b32_copy v1, s4
+  scratch_store_b32 off, v1, off offset:16 glc:0 slc:0 dlc:0
+  v_mov_b32_copy v2, s5
+  scratch_store_b32 off, v2, off offset:20 glc:0 slc:0 dlc:0
+  s_mov_b64 exec, s[0:1]
+  s_waitcnt_vscnt vscnt(0)
+  s_mov_b64_exec_read s[0:1]
+  s_mov_b64 exec, -1
+  scratch_load_b32 v3, off, off offset:16 glc:0 slc:0 dlc:0
+  s_waitcnt vmcnt(0) lgkmcnt(63)
+  v_readfirstlane_b32 s4, v3
+  scratch_load_b32 v3, off, off offset:20 glc:0 slc:0 dlc:0
+  s_waitcnt vmcnt(0) lgkmcnt(63)
+  v_readfirstlane_b32 s5, v3
+  s_mov_b64 exec, s[0:1]
+  s_load_dword s0, s[4:5] offset:8
+  s_waitcnt vmcnt(63) lgkmcnt(0)
+  s_mul_i32 s0, s0, s0
+  s_mov_b64_exec_read s[4:5]
+  s_mov_b64 exec, -1
+  v_mov_b32_copy v3, s0
+  scratch_store_b32 off, v3, off offset:4 glc:0 slc:0 dlc:0
+  s_mov_b64 exec, s[4:5]
+  s_mov_b64_exec_read s[0:1]
+  s_mov_b64 exec, -1
+  s_waitcnt_vscnt vscnt(0)
+  scratch_load_b32 v4, off, off offset:16 glc:0 slc:0 dlc:0
+  s_waitcnt vmcnt(0) lgkmcnt(63)
+  v_readfirstlane_b32 s4, v4
+  scratch_load_b32 v4, off, off offset:20 glc:0 slc:0 dlc:0
+  s_waitcnt vmcnt(0) lgkmcnt(63)
+  v_readfirstlane_b32 s5, v4
+  s_mov_b64 exec, s[0:1]
+  s_load_dword s0, s[4:5] offset:12
+  s_waitcnt vmcnt(63) lgkmcnt(0)
+  s_mul_i32 s0, s0, s0
+  s_mov_b64_exec_read s[4:5]
+  s_mov_b64 exec, -1
+  v_mov_b32_copy v4, s0
+  scratch_store_b32 off, v4, off offset:8 glc:0 slc:0 dlc:0
+  s_mov_b64 exec, s[4:5]
+  s_mov_b64_exec_read s[0:1]
+  s_mov_b64 exec, -1
+  s_waitcnt_vscnt vscnt(0)
+  scratch_load_b32 v5, off, off offset:16 glc:0 slc:0 dlc:0
+  s_waitcnt vmcnt(0) lgkmcnt(63)
+  v_readfirstlane_b32 s4, v5
+  scratch_load_b32 v5, off, off offset:20 glc:0 slc:0 dlc:0
+  s_waitcnt vmcnt(0) lgkmcnt(63)
+  v_readfirstlane_b32 s5, v5
+  s_mov_b64 exec, s[0:1]
+  s_load_dword s0, s[4:5] offset:16
+  s_waitcnt vmcnt(63) lgkmcnt(0)
+  s_mul_i32 s0, s0, s0
+  s_mov_b64_exec_read s[4:5]
+  s_mov_b64 exec, -1
+  v_mov_b32_copy v5, s0
